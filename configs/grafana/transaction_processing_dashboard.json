    {
      "title": "Authorization Pipeline Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(transaction_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p50 (ms)" },
        { "expr": "histogram_quantile(0.95, sum(rate(transaction_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95 (ms)" },
        { "expr": "histogram_quantile(0.99, sum(rate(transaction_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p99 (ms)" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "HTTP Response Status Distribution (2xx vs 4xx vs 5xx)",
