{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "panels": [
    {
      "title": "Total Fraud Value Intercepted & Blocked (INR)",
      "type": "stat",
      "targets": [
        { "expr": "sum(increase(fraud_amount_blocked_inr_total[24h]))", "legendFormat": "Blocked Fraud (₹)" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
    },
    {
      "title": "Live Fraud Detection Rate (Target > 95%)",
      "type": "gauge",
      "targets": [
        { "expr": "fraud:detection_rate:1h * 100", "legendFormat": "Detection Rate %" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 }
    },
    {
      "title": "False Positive Rate (Target < 0.5%)",
      "type": "gauge",
      "targets": [
        { "expr": "fraud:false_positive_rate:1h * 100", "legendFormat": "FPR %" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 }
    },
    {
      "title": "Risk Score Output Distribution",
      "type": "histogram",
      "targets": [
        { "expr": "sum by (le) (rate(fraud_risk_score_bucket[15m]))", "legendFormat": "Score Bucket" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 }
    },
    {
      "title": "Top 10 Triggered Fraud Rules",
      "type": "bargauge",
      "targets": [
        { "expr": "topk(10, sum by (rule_id) (rate(fraud_rule_triggers_total[1h])))", "legendFormat": "{{rule_id}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "title": "ML Model Ensemble Population Stability Index (PSI)",
      "type": "timeseries",
      "targets": [
        { "expr": "ml_feature_population_stability_index", "legendFormat": "PSI Index" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fraud", "detection", "ml", "rules"],
  "time": { "from": "now-6h", "to": "now" },
  "title": "ShieldPay - Fraud Detection & Risk Analytics Dashboard",
  "version": 1
}
